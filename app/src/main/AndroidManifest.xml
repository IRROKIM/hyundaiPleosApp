<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 차량(Android Automotive) 기기에서도, 일반 에뮬레이터에서도 설치되도록 required=false -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!-- 주행 세션 동안 앱 화면이 내려가도 음악을 이어 가기 위한 미디어 재생 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Pleos SDK 권한(최소 권한): 내비 경로 조회, 트립 거리·브레이크·주행 모드, 조명 상태 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:appCategory="audio"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RouteSoundtrack">

        <!-- AAOS 미디어 앱 선언 -->
        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- AAOS: 주행 중에도 화면을 띄울 수 있는 "주의 분산 최적화" 화면임을 선언 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- Pleos Music/Audio 앱 필수: MediaBrowserService + MediaSession -->
        <service
            android:name=".audio.SoundtrackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
